# /* ---- 💫 Hyprlock clean fingerprint edition 💫 ---- */
# Designed for JaKooLit Fedora Hyprland style
# Fingerprint + password UX with better visual hierarchy

source = $HOME/.config/hypr/wallust/wallust-hyprland.conf
$Scripts = $HOME/.config/hypr/scripts

# ---------------- AUTH ----------------
auth {
    pam:enabled = true
    pam:module = hyprlock

    fingerprint:enabled = true
    fingerprint:ready_message = Pose ton doigt ou tape ton mot de passe
    fingerprint:present_message = Vérification de l'empreinte...
    fingerprint:retry_delay = 300
}

# ---------------- GENERAL ----------------
general {
    grace = 1
    fractional_scaling = 2
    immediate_render = true
    hide_cursor = false
}

# ---------------- BACKGROUND ----------------
background {
    monitor =
    path = $HOME/.config/hypr/wallpaper_effects/.wallpaper_current
    color = rgb(0,0,0)

    blur_size = 4
    blur_passes = 3
    noise = 0.0117
    contrast = 1.2500
    brightness = 0.8200
    vibrancy = 0.2100
    vibrancy_darkness = 0.0
}

# ---------------- TIME ----------------
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%I:%M %p")"
    color = $color8
    font_size = 128
    font_family = JetBrainsMono Nerd Font ExtraBold
    position = 0, -240
    halign = center
    valign = top
}

# ---------------- DATE ----------------
label {
    monitor =
    text = cmd[update:18000000] echo "<b> "$(date +'%A, %-d %B')" </b>"
    color = $color13
    font_size = 44
    font_family = Victor Mono Bold Italic
    position = 0, -58
    halign = center
    valign = center
}

# ---------------- USER ----------------
label {
    monitor =
    text =   $USER
    color = $color9
    font_size = 32
    font_family = Victor Mono Bold Oblique
    position = 0, 285
    halign = center
    valign = bottom
}

# ---------------- FINGERPRINT BUTTON BACK RING ----------------
shape {
    monitor =
    size = 118, 118
    color = rgba(255, 255, 255, 0.05)
    rounding = 999
    border_size = 2
    border_color = $color8
    position = 0, 175
    halign = center
    valign = bottom
}

# ---------------- FINGERPRINT BUTTON INNER ----------------
shape {
    monitor =
    size = 92, 92
    color = rgba(255, 255, 255, 0.08)
    rounding = 999
    border_size = 0
    border_color = rgba(0,0,0,0)
    position = 0, 188
    halign = center
    valign = bottom
}

# ---------------- FINGERPRINT ICON ----------------
label {
    monitor =
    text = <span font="JetBrainsMono Nerd Font 42">󰷦</span>
    color = $color13
    font_size = 1
    position = 0, 207
    halign = center
    valign = bottom
}

# ---------------- FINGERPRINT STATUS ----------------
label {
    monitor =
    text = $FPRINTPROMPT
    color = $color13
    font_size = 17
    font_family = Victor Mono Bold Oblique
    position = 0, 115
    halign = center
    valign = bottom
}

# ---------------- PASSWORD INPUT BACK PLATE ----------------
shape {
    monitor =
    size = 340, 78
    color = rgba(255, 255, 255, 0.06)
    rounding = 18
    border_size = 2
    border_color = rgba(255, 255, 255, 0.10)
    position = 0, 22
    halign = center
    valign = bottom
}

# ---------------- INPUT FIELD ----------------
input-field {
    monitor =
    size = 300, 58
    outline_thickness = 2
    dots_size = 0.22
    dots_spacing = 0.18
    dots_center = true

    outer_color = $color8
    inner_color = rgba(255, 255, 255, 0.02)
    check_color = rgb(120, 255, 120)
    fail_color = rgb(255, 90, 90)
    capslock_color = rgb(255,255,255)

    font_color = $color13
    fade_on_empty = false
    font_family = Victor Mono Bold Oblique
    hide_input = false

    placeholder_text = <i><span foreground="#ffffff99">🔒 Mot de passe</span></i>

    position = 0, 32
    halign = center
    valign = bottom
}

# ---------------- PAM PROMPT / SUCCESS FEEDBACK ----------------
label {
    monitor =
    text = $PAMPROMPT
    color = rgb(120, 255, 120)
    font_size = 14
    font_family = Victor Mono Bold Oblique
    position = 0, -20
    halign = center
    valign = bottom
}

# ---------------- PASSWORD FAIL FEEDBACK ----------------
label {
    monitor =
    text = $PAMFAIL
    color = rgb(255, 90, 90)
    font_size = 14
    font_family = Victor Mono Bold Oblique
    position = 0, -42
    halign = center
    valign = bottom
}

# ---------------- FINGERPRINT FAIL FEEDBACK ----------------
label {
    monitor =
    text = $FPRINTFAIL
    color = rgb(255, 110, 110)
    font_size = 14
    font_family = Victor Mono Bold Oblique
    position = 0, 90
    halign = center
    valign = bottom
}

# ---------------- KEYBOARD LAYOUT ----------------
label {
    monitor =
    text = $LAYOUT
    color = $color8
    font_size = 14
    font_family = Victor Mono Bold Oblique
    position = 0, 72
    halign = center
    valign = bottom
}

# ---------------- UPTIME ----------------
label {
    monitor =
    text = cmd[update:60000] echo "<b> "$(uptime -p || $Scripts/UptimeNixOS.sh)" </b>"
    color = $color8
    font_size = 22
    font_family = Victor Mono Bold Oblique
    position = 0, 0
    halign = right
    valign = bottom
}

# ---------------- BATTERY ----------------
label {
    monitor =
    text = cmd[update:1000] echo "<b> "$($Scripts/Battery.sh)" </b>"
    color = $color8
    font_size = 16
    font_family = Victor Mono Bold Oblique
    position = 0, 30
    halign = right
    valign = bottom
}

# ---------------- WEATHER ----------------
label {
    monitor =
    text = cmd[update:3600000] [ -f "$HOME/.cache/.weather_cache" ] && cat "$HOME/.cache/.weather_cache"
    color = $color8
    font_size = 14
    font_family = Victor Mono Bold Oblique
    position = 50, 0
    halign = left
    valign = bottom
}

# ---------------- OPTIONAL SUBTEXT ----------------
label {
    monitor =
    text = <span foreground="#ffffff88">Empreinte ou mot de passe</span>
    color = $color8
    font_size = 13
    font_family = Victor Mono Bold Oblique
    position = 0, 146
    halign = center
    valign = bottom
}
